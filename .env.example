# Copy to .dev.vars for local development. Never commit real secrets.

# Local development only. Staging and production never set these.
ENVIRONMENT="development"
DEV_AUTH_EMAIL="owner@example.com"

# Cloudflare Access application settings. Required in staging and production.
# The team domain looks like https://your-team.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=""
ACCESS_AUD=""
